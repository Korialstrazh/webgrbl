{
  "name": "webgrbl",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "node tools/select-worktree.cjs",
    "dev:root": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --maxWorkers=4",
    "locales:update": "node ./tools/localization/build.locales.from.csv.cjs",
    "locales:check": "npm run locales:update && git diff --exit-code -- src/utils/localization/default.locales.ts tools/localization",
    "check": "npm run lint && npm run typecheck && npm test && npm run locales:check && npm run build && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@reduxjs/toolkit": "2.13.0",
    "antd": "6.6.8",
    "dexie": "4.4.7",
    "i18next": "26.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-redux": "9.3.0",
    "redux-saga": "1.5.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/w3c-web-serial": "1.0.8",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "sass": "1.105.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "@rc-component/segmented": {
      "@babel/runtime": "8.0.8"
    },
    "@rc-component/virtual-list": {
      "@babel/runtime": "8.0.8"
    },
    "minimatch": "11.0.3",
    "glob": "14.0.3",
    "@trickfilm400/rollup-plugin-off-main-thread": "4.0.0"
  }
}
