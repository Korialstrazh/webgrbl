# Per-developer Gitea configuration
.gitea-local

# The maintainer's personal rules, agent instructions, skills, specs and plans: kept on the maintainer's machine only,
# never published.
docs/rulesets/
docs/project-rules/
docs/superpowers/
.claude/skills/
AGENTS.md
CLAUDE.md
.superpowers/
graphify-out/

# Local secrets, logs and coverage
.env*
*.log
coverage/

# Agent worktrees
.claude/worktrees/
.worktrees/
.claude/settings.local.json

# Dependencies and build output
node_modules/
dist/
dev-dist/

# Local vitest report output
.vitest/

# Read-only clones of upstream projects used as reference (e.g. LaserGRBL)
.reference/
*.tsbuildinfo
